{
  "name": "clipaible",
  "version": "3.3.0",
  "description": "AI-Powered Article Extractor Chrome Extension",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:worker": "node build-tts-worker.js",
    "build:worker:watch": "nodemon --watch src/tts-worker-entry.js --exec 'npm run build:worker'",
    "build:offscreen": "node build-offscreen.js",
    "build:offscreen:watch": "nodemon --watch offscreen.js --exec 'npm run build:offscreen'",
    "build:extraction": "node build-extraction.js",
    "build": "npm run build:extraction && npm run build:offscreen && npm run build:worker",
    "dev": "npm run build:offscreen:watch"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.4",
    "esbuild": "^0.19.0",
    "jsdom": "^27.4.0",
    "nodemon": "^3.0.0",
    "vitest": "^1.0.4"
  },
  "keywords": [
    "chrome-extension",
    "article-extractor",
    "pdf",
    "epub",
    "fb2",
    "markdown",
    "audio",
    "tts",
    "ai",
    "translation"
  ],
  "author": "YanGranat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanGranat/ClipAIble"
  },
  "homepage": "https://github.com/YanGranat/ClipAIble#readme",
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "js-tts-wrapper": "^0.1.63",
    "onnxruntime-web": "1.19.0"
  }
}
