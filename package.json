{
  "name": "clipaible",
  "version": "3.3.26",
  "description": "AI-Powered Article Extractor Chrome Extension",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:worker": "node build-tts-worker.js",
    "build:worker:watch": "nodemon --watch src --watch scripts --watch build-tts-worker.js --watch build-piper.js --watch lib/piper-wasm --ext js,mjs,wasm,data --exec \"npm run build:worker\"",
    "build:offscreen": "node build-offscreen.js",
    "build:offscreen:watch": "nodemon --watch offscreen.js --watch scripts --watch build-offscreen.js --watch build-piper.js --watch lib/piper-wasm --ext js,mjs,wasm,data --exec \"npm run build:offscreen\"",
    "build:extraction": "node build-extraction.js && node scripts/apply-extraction-build.js",
    "build": "npm run build:extraction && npm run build:offscreen && npm run build:worker",
    "package:production": "node create-production-archive.js",
    "dev": "npm run build:offscreen:watch",
    "check": "tsc --project jsconfig.json && tsc --project jsconfig.node.json"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "nodemon": "^3.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "chrome-extension",
    "article-extractor",
    "pdf",
    "epub",
    "fb2",
    "markdown",
    "audio",
    "tts",
    "ai",
    "translation"
  ],
  "author": "YanGranat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanGranat/ClipAIble"
  },
  "homepage": "https://github.com/YanGranat/ClipAIble#readme",
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "html-to-image": "1.11.13",
    "onnxruntime-web": "1.19.0",
    "tesseract.js": "7.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
